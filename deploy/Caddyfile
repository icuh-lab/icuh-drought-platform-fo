# 가뭄영향정보플랫폼 리버스 프록시
#
# Caddy 가 Let's Encrypt 인증서를 자동 발급·갱신한다. 발급은 80 포트를 통해
# 이뤄지므로 보안그룹에 80 과 443 이 모두 열려 있어야 한다.
#
# 앱·API 컨테이너는 호스트 포트를 열지 않는다. 같은 docker 네트워크(web)에 붙여
# 컨테이너 이름으로 접근하므로 외부에서 3000/8081/8083 으로 직접 들어올 경로가 없다.

infradna.io.kr {
	reverse_proxy icuh-drought-platform-fo:3000

	encode gzip zstd

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# 백엔드 API 두 개.
#
# 프론트는 브라우저에서 이 주소들을 직접 호출한다(모든 호출부가 클라이언트 컴포넌트).
# 페이지가 HTTPS 이므로 API 도 HTTPS 여야 한다. IP+포트로 두면 mixed content 로 차단된다.
#
# CORS 는 각 API 가 직접 내려준다. Caddy 는 헤더를 건드리지 않는다.

api.infradna.io.kr {
	reverse_proxy icuh-public-api:8081

	encode gzip zstd

	log {
		output file /var/log/caddy/api.access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

open-api.infradna.io.kr {
	reverse_proxy icuh-open-api:8083

	encode gzip zstd

	log {
		output file /var/log/caddy/open-api.access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# 기존 프론트(icuh-platform-fo)를 되살릴 때는 아래를 참고해 블록을 추가한다.
# 그 컨테이너는 -p 80:80 으로 뜨도록 되어 있어 그대로 실행하면 Caddy 와 충돌한다.
# 반드시 호스트 포트 매핑 없이 --network web 으로 띄운 뒤 이름으로 연결한다.
#
# platform.infradna.io.kr {
# 	reverse_proxy icuh-platform-fo:80
# }
